{
  "name": "footfall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "tsc --noEmit && oxlint && vitest run",
    "deploy": "sh scripts/deploy.sh",
    "fetch": "node --experimental-transform-types --no-warnings scripts/fetch.ts",
    "demo:data": "node --experimental-transform-types --no-warnings scripts/demo.ts",
    "demo": "FOOTFALL_DATA=.data-demo FOOTFALL_APP_ID=demo FOOTFALL_DOMAIN=example.com vite"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6",
    "jsdom": "^30",
    "oxlint": "^1.85.0",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^5"
  }
}
